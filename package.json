{
  "name": "dsh-engineer-mode",
  "version": "0.11.0",
  "description": "Engineer mode：29 个 ds-* 技能进预设（含 PROGRESS.md 换上下文常驻块）、5 条守卫、意图路由与推理强度路由，自带 dsh-go 界面。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/skills",
    "skills.manifest.json",
    "cordis.patch.yml",
    "RESIDENT.md",
    "CHECKLIST.md",
    "INSTALL.txt",
    "scripts/install.mjs",
    "scripts/build-bundle.mjs",
    "README.md",
    "test",
    "scripts/guard-replay.mjs",
    "scripts/migrate-sessions.mjs",
    "docs/mapping.md",
    "CHANGELOG.md",
    "presets",
    "ui"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "go": {
      "ui": "./ui/go.json",
      "minAppVersion": "1.0.13"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "replay": "node scripts/guard-replay.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnSun-debug/dsh-stack.git"
  },
  "homepage": "https://github.com/ShawnSun-debug/dsh-stack",
  "bugs": {
    "url": "https://github.com/ShawnSun-debug/dsh-stack/issues"
  },
  "keywords": [
    "dsh",
    "engineer-mode",
    "agent-preset",
    "skills",
    "dsh-go"
  ]
}
