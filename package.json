{
  "name": "dsh-stack",
  "version": "0.4.0",
  "description": "Resident skill baseline for the ds-stack pack: keeps 8 curated ds-* skills present in a profile (local loose copies still win).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/skills",
    "skills.manifest.json",
    "cordis.patch.yml",
    "RESIDENT.md",
    "CHECKLIST.md",
    "INSTALL.txt",
    "scripts/install.mjs",
    "scripts/build-bundle.mjs",
    "README.md",
    "test"
  ],
  "license": "MIT",
  "private": true,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/guard.test.mjs"
  }
}
